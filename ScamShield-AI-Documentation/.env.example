# ScamShield AI - example configuration ONLY. No real credentials.
# Documentation package; service code/compose files are not included.
APP_ENV=local
SCAN_MODE=fixture
WEB_PORT=3000
API_PORT=8000
DATABASE_URL=postgresql+psycopg://scamshield:change-me@postgres:5432/scamshield
REDIS_URL=redis://redis:6379/0
API_AUTH_SECRET=replace-with-strong-random-server-secret
EVIDENCE_STORAGE_PATH=/data/evidence
SCAN_MAX_REDIRECTS=5
SCAN_TIMEOUT_SECONDS=25
SCAN_MAX_CONCURRENCY=2
ALLOWED_WEB_ORIGINS=http://localhost:3000
SERPAPI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
URLSCAN_API_KEY=
AI_PROVIDER=none
AI_API_KEY=
RULESET_SIGNING_KEY=
# Keep public deployment disabled until network sandbox, auth and privacy review.
ALLOW_PUBLIC_DEPLOYMENT=false
