  "components": {
    "schemas": {
      "BatchItem": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Label"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "brand_target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Target"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reason Codes"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "BatchItem"
      },
      "BatchRequest": {
        "properties": {
          "urls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5000,
            "minItems": 1,
            "title": "Urls"
          }
        },
        "type": "object",
        "required": [
          "urls"
        ],
        "title": "BatchRequest"
      },
      "BatchResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "items"
        ],
        "title": "BatchResponse"
      },
      "Brand": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Short slug, e.g. 'tamm'"
          },
          "name_en": {
            "type": "string",
            "title": "Name En"
          },
          "name_ar": {
            "type": "string",
            "title": "Name Ar"
          },
          "category": {
            "type": "string",
            "enum": [
              "government",
              "police",
              "bank",
              "telecom",
              "transport",
              "utility",
              "delivery"
            ],
            "title": "Category"
          },
          "official_domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Official Domains",
            "description": "Registrable domains only, e.g. 'tamm.abudhabi'; subdomains count as official"
          },
          "helplines": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Helplines",
            "description": "As printed on the official site, e.g. '600 54 0000'"
          },
          "keywords_en": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords En"
          },
          "keywords_ar": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords Ar"
          },
          "logo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logo",
            "description": "Path under data/logos/"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name_en",
          "name_ar",
          "category",
          "official_domains"
        ],
        "title": "Brand"
      },
      "Candidate": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query",
            "description": "Search query, brand keyword or listing search that found it"
          },
          "discovered_at": {
            "type": "string",
            "format": "date-time",
            "title": "Discovered At"
          },
          "extra": {
            "$ref": "#/components/schemas/CandidateExtra"
          }
        },
        "type": "object",
        "required": [
          "url",
          "source",
          "discovered_at"
        ],
        "title": "Candidate",
        "description": "A URL found by the radar or submitted by a person."
      },
      "CandidateExtra": {
        "properties": {
          "listing_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Listing Name"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          }
        },
        "type": "object",
        "title": "CandidateExtra"
      },
      "Case": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "dismissed"
            ],
            "title": "Status"
          },
          "candidate": {
            "$ref": "#/components/schemas/Candidate"
          },
          "evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Evidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/Decision"
            },
            "type": "array",
            "title": "Decisions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "domain",
          "status",
          "candidate",
          "verdict"
        ],
        "title": "Case"
      },
      "CaseList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CaseSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "CaseList"
      },
      "CaseSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query"
          },
          "discovered_at": {
            "type": "string",
            "format": "date-time",
            "title": "Discovered At"
          },
          "verdict": {
            "$ref": "#/components/schemas/Label"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "brand_target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Brand Target"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "confirmed",
              "dismissed"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "url",
          "domain",
          "source",
          "query",
          "discovered_at",
          "verdict",
          "score",
          "brand_target",
          "status"
        ],
        "title": "CaseSummary"
      },
      "CheckRequest": {
        "properties": {
          "input": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 3,
            "title": "Input",
            "description": "A link or a phone number"
          }
        },
        "type": "object",
        "required": [
          "input"
