    "/api/batch": {
      "post": {
        "tags": [
          "scan"
        ],
        "summary": "Batch",
        "description": "Score many URLs at once. `?format=csv` returns a CSV file.",
        "operationId": "batch_api_batch_post",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(json|csv)$",
              "default": "json",
              "title": "Format"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
