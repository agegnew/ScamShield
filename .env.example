# Copy to .env (never commit .env). docker-compose and the backend read it.

# mock = demo cases are loaded and responses say X-ScamShield-Mode: mock
SCAMSHIELD_MODE=mock

# Login. Seeded accounts are created once, when the users table is empty
# (defaults admin123 / analyst123 are for the local demo only).
SCAMSHIELD_ADMIN_PASSWORD=
SCAMSHIELD_ANALYST_PASSWORD=
# Token signing secret; empty = a random one saved in backend/.jwt-secret
SCAMSHIELD_JWT_SECRET=
SCAMSHIELD_TOKEN_HOURS=12
# 1 = dashboard reads (cases, radar, graph, scan, batch) need login too
SCAMSHIELD_REQUIRE_LOGIN=0

# Google Search + Maps radar (free plan at serpapi.com: 250 searches a month).
# Without a key the radar replays answers saved earlier in data/cache/serp/.
SERPAPI_KEY=
# Live searches per radar run; the daily run spreads the month and keeps the reserve back.
SCAMSHIELD_SERPAPI_RUN_MAX=40
SCAMSHIELD_SERPAPI_RESERVE=30

# Whole radar run every day at this UAE time (plus the "Run radar now" button)
SCAMSHIELD_RADAR_DAILY=1
SCAMSHIELD_RADAR_DAILY_AT=03:00
# Page checks per run, riskiest URL first
SCAMSHIELD_RADAR_MAX_FETCH=300

# Claude's second look at borderline pages (score 20-79 after the page check). Empty = off.
ANTHROPIC_API_KEY=
SCAMSHIELD_AI_MODEL=claude-opus-5-5
# Reviews per day at most (about 3-5 US cents each)
SCAMSHIELD_AI_DAILY_LIMIT=300

# Demo laptop only: hostnames of the local demo pages the worker may open even though they
# resolve to a local address (see demo-pages/README.md). Keep empty everywhere else.
# SCAMSHIELD_DEMO_HOSTS=tamm-fines-pay.ae,emiratesnbd-verify.com,gulfdriverguide.ae
SCAMSHIELD_DEMO_HOSTS=
