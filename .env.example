# Copy to .env (never commit .env). docker-compose reads it automatically.

# mock = demo cases are loaded and responses say X-ScamShield-Mode: mock
SCAMSHIELD_MODE=mock

# Google Search + Maps radar (Simon). Leave empty to keep those sources off.
SERPAPI_KEY=

# LLM for borderline cases (P1). Leave empty to keep it off.
LLM_API_KEY=
