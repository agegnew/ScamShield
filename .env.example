# Copy to .env (never commit .env). docker-compose and the backend read it.

# mock = demo cases are loaded and responses say X-ScamShield-Mode: mock
SCAMSHIELD_MODE=mock

# Google Search + Maps radar (free plan at serpapi.com).
# Without a key the radar replays answers saved earlier in data/cache/serp/.
SERPAPI_KEY=

# LLM for borderline cases (P1). Leave empty to keep it off.
LLM_API_KEY=

# Demo laptop only: hostnames of the local demo pages the worker may open even though they
# resolve to a local address (see demo-pages/README.md). Keep empty everywhere else.
# SCAMSHIELD_DEMO_HOSTS=tamm-fines-pay.ae,emiratesnbd-verify.com,gulfdriverguide.ae
SCAMSHIELD_DEMO_HOSTS=
